generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  email              String
  passwordHash       String     @map("password_hash")
  firstName          String     @map("first_name")
  lastName           String     @map("last_name")
  phone              String?
  documentNumber     String?    @map("document_number")
  position           String?
  avatarMediaId      String?    @map("avatar_media_id") @db.Uuid
  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean    @default(true) @map("must_change_password")
  lastLoginAt        DateTime?  @map("last_login_at")
  isDeleted          Boolean    @default(false) @map("is_deleted")
  createdAt          DateTime   @default(now()) @map("created_at")
  createdById        String?    @map("created_by_id") @db.Uuid
  updatedAt          DateTime   @updatedAt @map("updated_at")
  updatedById        String?    @map("updated_by_id") @db.Uuid
  deletedAt          DateTime?  @map("deleted_at")
  deletedById        String?    @map("deleted_by_id") @db.Uuid

  userRoles UserRole[]
  posts     Post[]     @relation("PostAuthor")

  @@map("users")
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  code        String
  description String?
  isSystem    Boolean   @default(false) @map("is_system")
  isDeleted   Boolean   @default(false) @map("is_deleted")
  createdAt   DateTime  @default(now()) @map("created_at")
  createdById String?   @map("created_by_id") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at")
  updatedById String?   @map("updated_by_id") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")
  deletedById String?   @map("deleted_by_id") @db.Uuid

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  module      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Company {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  legalName   String?       @map("legal_name")
  taxId       String?       @map("tax_id")
  email       String?
  phone       String?
  address     String?
  website     String?
  status      CompanyStatus @default(ACTIVE)
  notes       String?
  isDeleted   Boolean       @default(false) @map("is_deleted")
  createdAt   DateTime      @default(now()) @map("created_at")
  createdById String?       @map("created_by_id") @db.Uuid
  updatedAt   DateTime      @updatedAt @map("updated_at")
  updatedById String?       @map("updated_by_id") @db.Uuid
  deletedAt   DateTime?     @map("deleted_at")
  deletedById String?       @map("deleted_by_id") @db.Uuid

  contacts CompanyContact[]

  @@map("companies")
}

model CompanyContact {
  id          String        @id @default(uuid()) @db.Uuid
  companyId   String        @map("company_id") @db.Uuid
  firstName   String        @map("first_name")
  lastName    String        @map("last_name")
  email       String?
  phone       String?
  position    String?
  isPrimary   Boolean       @default(false) @map("is_primary")
  status      CompanyStatus @default(ACTIVE)
  notes       String?
  isDeleted   Boolean       @default(false) @map("is_deleted")
  createdAt   DateTime      @default(now()) @map("created_at")
  createdById String?       @map("created_by_id") @db.Uuid
  updatedAt   DateTime      @updatedAt @map("updated_at")
  updatedById String?       @map("updated_by_id") @db.Uuid
  deletedAt   DateTime?     @map("deleted_at")
  deletedById String?       @map("deleted_by_id") @db.Uuid

  company Company @relation(fields: [companyId], references: [id])

  @@map("company_contacts")
}

model MediaFile {
  id          String    @id @default(uuid()) @db.Uuid
  fileName    String    @map("file_name")
  mimeType    String    @map("mime_type")
  size        Int
  data        Bytes
  isDeleted   Boolean   @default(false) @map("is_deleted")
  createdAt   DateTime  @default(now()) @map("created_at")
  createdById String?   @map("created_by_id") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")
  deletedById String?   @map("deleted_by_id") @db.Uuid

  @@map("media_files")
}

model PostCategory {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  slug        String
  isDeleted   Boolean   @default(false) @map("is_deleted")
  createdAt   DateTime  @default(now()) @map("created_at")
  createdById String?   @map("created_by_id") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at")
  updatedById String?   @map("updated_by_id") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")
  deletedById String?   @map("deleted_by_id") @db.Uuid

  posts Post[]

  @@map("post_categories")
}

model PostTag {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  slug        String
  isDeleted   Boolean   @default(false) @map("is_deleted")
  createdAt   DateTime  @default(now()) @map("created_at")
  createdById String?   @map("created_by_id") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at")
  updatedById String?   @map("updated_by_id") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")
  deletedById String?   @map("deleted_by_id") @db.Uuid

  posts PostTagRelation[]

  @@map("post_tags")
}

model Post {
  id           String     @id @default(uuid()) @db.Uuid
  title        String
  slug         String
  excerpt      String?
  content      String
  status       PostStatus @default(DRAFT)
  coverImageId String?    @map("cover_image_id") @db.Uuid
  categoryId   String?    @map("category_id") @db.Uuid
  authorId     String     @map("author_id") @db.Uuid
  publishedAt  DateTime?  @map("published_at")
  isDeleted    Boolean    @default(false) @map("is_deleted")
  createdAt    DateTime   @default(now()) @map("created_at")
  createdById  String?    @map("created_by_id") @db.Uuid
  updatedAt    DateTime   @updatedAt @map("updated_at")
  updatedById  String?    @map("updated_by_id") @db.Uuid
  deletedAt    DateTime?  @map("deleted_at")
  deletedById  String?    @map("deleted_by_id") @db.Uuid

  author   User              @relation("PostAuthor", fields: [authorId], references: [id])
  category PostCategory?     @relation(fields: [categoryId], references: [id])
  tags     PostTagRelation[]

  @@map("posts")
}

model PostTagRelation {
  postId String @map("post_id") @db.Uuid
  tagId  String @map("tag_id") @db.Uuid

  post Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  PostTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@map("post_tag_relations")
}
